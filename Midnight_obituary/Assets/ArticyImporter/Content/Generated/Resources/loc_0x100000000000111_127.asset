  mLocalizedStringsValues:
  - "\u903B\u8F91\u68C0\u5B9A"
  - "\u3010\u7535\u8BDD\u505C\u673A\u3011\u3010\u623F\u79DF\u3011\u601D\u8003\u5979\u9047\u5230\u4E86\u4EC0\u4E48\u95EE\u9898"
  - "\u611F\u77E5\u68C0\u5B9A"
  - "\u3010\u4ECD\u7136\u5E73\u9759\u3011\u3010\u63A9\u76D6\u54ED\u58F0\u3011\u601D\u8003\u5979\u521A\u624D\u7684\u8868\u73B0"
  - "\u654F\u9510\u68C0\u5B9A"
  - "\u3010\u4E16\u754C\u4E0D\u662F\u4E3A\u6211\u4EEC\u8FD9\u6837\u7684\u4EBA\u51C6\u5907\u7684\u3011\u6355\u6349\u8BDD\u8BED\u80CC\u540E\u7684\u542B\u4E49"
  - "\u654F\u9510\u68C0\u5B9A"
  - "\u3010\u66F4\u53EF\u9760\u7684\u4EBA\u3011\u601D\u8003\u8868\u8FBE\u80CC\u540E\u7684\u6F0F\u6D1E"
  - "\u903B\u8F91\u68C0\u5B9A"
  - "\u3010\u5B63\u5EA6\u53D1\u653E\u7684\u8865\u52A9\u3011\u601D\u8003\u8FD9\u9879\u653F\u7B56"
  - "\u611F\u77E5\u68C0\u5B9A"
  - "\u3010\u65E7\u8863\u670D\u3011\u601D\u8003\u6731\u8FEA\u4E1D\u7684\u8BB2\u8FF0"
  - "\u903B\u8F91\u68C0\u5B9A"
  - "\u3010\u65E7\u8863\u670D\u3011\u601D\u8003\u6731\u8FEA\u4E1D\u7684\u8BB2\u8FF0"
  - "\u63A5\u5165\u7535\u8BDD"
  - "\u63A5\u5165\u7535\u8BDD"
  - "\u60AC\u7F6E\u7535\u8BDD"
  - "\u60AC\u7F6E\u7535\u8BDD\uFF08\u7EE7\u7EED\u5BF9\u8BDD\u6BCF3\u53E5\u8BDD\u538B\u529B+1\uFF09"
  - "\u5F00\u573A"
  - judith
  - "\u5F00\u573A"
  - "\u5C55\u5F00\u5BF9\u8BDD"
  - "\u8BA1\u65F6\u7ED3\u675F"
  - "\u6731\u8FEA\u4E1D\u79BB\u7EBF"
  - "\u547C\u53EB\u4E2D......"
  - "\u4F60\u4ECD\u65E7\u5750\u5728\u90A3\u628A\u9648\u65E7\u7684\u6276\u624B\u6905\u4E2D\uFF0C\u67D4\u8F6F\u7684\u706F\u82AF\u7ED2\u78E8\u8E6D\u7740\u4F60\u7684\u6307\u8179\u3002\u800C\u4F60\u7684\u53E6\u4E00\u90E8\u5206\uFF0C\u4E0E\u6211\u6C34\u4E73\u4EA4\u878D\u7684\u90A3\u4E00\u90E8\u5206\uFF0C\u5728\u6A21\u7CCA\u3001\u673A\u68B0\u7684\u547C\u58F0\u54CD\u8D77\u7684\u65F6\u523B\uFF0C\u5B9B\u5982\u4E00\u53EA\u8F7B\u4E3E\u7684\u8774\u8776\uFF0C\u6295\u5165\u4E86\u57CE\u5E02\u7684\u832B\u832B\u591C\u8272\uFF0C\u7A7F\u884C\u4E8E\u6D69\u701A\u65E0\u57A0\u7684\u94DC\u7EDE\u7EBF\u7F51\u7EDC\u4E4B\u4E2D\u3002"
  - "\u547C\u53EB\u4E2D......"
  - "\u5C31\u5982\u65E0\u6570\u4E2A\u591C\u665A\uFF0C\u8774\u8776\u5728\u5176\u4E2D\u7A7F\u884C\u2014\u2014\u7A7F\u8FC7\u4EA4\u6362\u673A\u3001\u65E0\u4EBA\u503C\u5B88\u7684\u603B\u673A\uFF0C\u7A7F\u8FC7\u65E7\u7816\u697C\u5185\u8001\u5316\u7684\u7EBF\u8DEF\uFF0C\u6700\u540E\uFF0C\u5B83\u5728\u4E00\u95F4\u72ED\u7A84\u7684\u94C1\u9053\u516C\u5BD3\u91CC\u94BB\u4E86\u51FA\u6765\uFF0C\u53D8\u6210\u4E00\u4E32\u7B28\u62D9\u800C\u5C16\u9510\u7684\u7535\u8BDD\u94C3\u58F0\u3002"
  - "\u547C\u53EB\u4E2D......\u7B49\u5F85\u63A5\u901A......"
  - "\u4F60\u597D\uFF1F"
  - "\u4E00\u4F4D\u4E09\u5341\u5C81\u5DE6\u53F3\u5E74\u8F7B\u5973\u6027\u7684\u58F0\u97F3\uFF0C\u4F34\u968F\u7740\u6C99\u6C99\u7684\u767D\u566A\u58F0\u5728\u542C\u7B52\u4E2D\u54CD\u8D77\u3002\u5979\u7684\u58F0\u97F3\u5F88\u5E73\u9759\uFF0C\u5E26\u7740\u4E00\u4E1D\u75B2\u60EB\u3002"
  - "\u547C\u53EB\u4E2D......"
  - "\u4F60\u4ECD\u65E7\u5750\u5728\u90A3\u628A\u9648\u65E7\u7684\u6276\u624B\u6905\u4E2D\uFF0C\u67D4\u8F6F\u7684\u706F\u82AF\u7ED2\u78E8\u8E6D\u7740\u4F60\u7684\u6307\u8179\u3002\u800C\u4F60\u7684\u53E6\u4E00\u90E8\u5206\uFF0C\u4E0E\u6211\u6C34\u4E73\u4EA4\u878D\u7684\u90A3\u4E00\u90E8\u5206\uFF0C\u5F53\u542C\u7B52\u4E2D\u673A\u68B0\u7684\u547C\u58F0\u54CD\u8D77\u65F6\uFF0C\u5B9B\u5982\u4E00\u53EA\u8F7B\u4E3E\u7684\u8774\u8776\uFF0C\u970E\u90A3\u95F4\u6295\u5165\u57CE\u5E02\u7684\u832B\u832B\u591C\u8272\uFF0C\u7A7F\u884C\u5728\u6D69\u701A\u65E0\u57A0\u7684\u94DC\u7EDE\u7EBF\u7F51\u7EDC\u4E4B\u4E2D\u3002"
  - "\u547C\u53EB\u4E2D......"
  - "\u5C31\u5982\u65E0\u6570\u4E2A\u591C\u665A\uFF0C\u8774\u8776\u5728\u5176\u4E2D\u7A7F\u884C\u2014\u2014\u7A7F\u8FC7\u4EA4\u6362\u673A\u3001\u65E0\u4EBA\u503C\u5B88\u7684\u603B\u673A\uFF0C\u7A7F\u8FC7\u65E7\u7816\u697C\u5185\u8001\u5316\u7684\u7EBF\u8DEF......\u6700\u540E\uFF0C\u5B83\u4ECE\u53E6\u4E00\u53F0\u7535\u8BDD\u4E2D\u94BB\u51FA\u6765\uFF0C\u53D8\u6210\u4E00\u4E32\u7B28\u62D9\u800C\u5C16\u9510\u7684\u7535\u8BDD\u94C3\u58F0\uFF0C\u5728\u4E00\u95F4\u72ED\u7A84\u7684\u94C1\u9053\u516C\u5BD3\u91CC\u56DE\u54CD\u3002"
  - "\u547C\u53EB\u4E2D......\u7B49\u5F85\u63A5\u901A......"
  - "\u4F60\u597D\uFF1F"
  - "\u4E00\u4F4D\u4E0D\u5230\u4E09\u5341\u5C81\u7684\u9752\u5E74\u5973\u6027\u7684\u58F0\u97F3\uFF0C\u4F34\u968F\u7740\u6C99\u6C99\u7684\u767D\u566A\u58F0\u5728\u542C\u7B52\u4E2D\u54CD\u8D77\u3002\u5979\u7684\u58F0\u97F3\u5F88\u5E73\u9759\uFF0C\u5E26\u7740\u4E00\u4E1D\u5FAE\u4E0D\u53EF\u5BDF\u7684\u75B2\u60EB\u3002"
  - "\u8FD9\u91CC\u662F\u7FF0\u83B1\u592A\u592A\u5417\uFF1F"
  - "\u6731\u8FEA\u4E1D\xB7\u7FF0\u83B1\uFF1F"
  - "\u662F\u7684\uFF0C\u662F\u6211\u3002"
  - "\u5728\u7535\u4FE1\u53F7\u7EC6\u96E8\u822C\u7684\u566A\u58F0\u4E4B\u4E2D\uFF0C\u4F60\u542C\u89C1\u4E00\u58F0\u4F4E\u5FAE\u7684\u5462\u5583\u3002"
  - "\u5947\u602A......\u7535\u8BDD\u5E94\u8BE5\u5DF2\u7ECF\u505C\u673A\u4E86......"
  - "\u662F\u54EA\u4F4D\uFF1F\u542C\u7740......\u5982\u679C\u662F\u5173\u4E8E\u623F\u79DF\u7684\uFF0C\u4ECA\u665A\u6211\u6CA1\u6CD5\u8C08\u8FD9\u4E2A\u3002"
  - "\u5C3D\u7BA1\u5979\u5DF2\u7ECF\u51B3\u5B9A\u8981\u5728\u4E0D\u4E45\u4E4B\u540E\u7ED3\u675F\u81EA\u5DF1\u7684\u751F\u547D\uFF0C\u5979\u7684\u8BED\u6C14\u5374\u4FDD\u6301\u7740\u793C\u8C8C\u3002"
  - "[chapterjudith.calling_her_by]\uFF0C\u8BF7\u4E0D\u8981\u6302\u65AD\u3002\u6211\u7684\u540D\u5B57\u662F\u5948\u7279\u3002\u4E5F\u8BB8\u8FD9\u4E48\u8BF4\u6709\u4E9B\u5947\u602A\uFF0C\u6211\u6253\u6765\u662F\u60F3\u5411\u4F60\u786E\u8BA4\uFF0C\u5728\u8FD9\u51E0\u5206\u949F\u91CC\uFF0C\u4F60\u548C\u4E39\u5C3C\u662F\u5B89\u5168\u7684\u5417\uFF1F"
  - "\u5979\u6C89\u9ED8\u4E86\u4E00\u4F1A\u513F\u3002\u5F53\u5979\u7684\u58F0\u97F3\u518D\u6B21\u54CD\u8D77\u65F6\uFF0C\u4F60\u5BDF\u89C9\u5230\u90A3\u79CD\u75B2\u60EB\u50CF\u65E7\u5899\u58C1\u4E0A\u7684\u88C2\u75D5\uFF0C\u5728\u66F4\u591A\u7684\u97F3\u8282\u4E4B\u95F4\u6084\u65E0\u58F0\u606F\u5730\u873F\u8712\u5F00\u3002"
  - "\u4F60\u4F1A\u8FD9\u4E48\u8BF4\uFF0C\u786E\u5B9E\u5F88\u5947\u602A......\u4E0D\u8FC7\uFF0C\u662F\u7684\uFF0C\u8FD9\u51E0\u5206\u949F\u7684\u8BDD\u3002"
  - "[chapterjudith.calling_her_by]\uFF0C\u4F60\u53EF\u4EE5\u7B54\u5E94\u6211\u5728\u63A5\u4E0B\u6765\u7684\u4E00\u5C0F\u6BB5\u65F6\u95F4\uFF0C\u4E0D\u8981\u6309\u4E0B\u6302\u65AD\u952E\uFF0C\u548C\u6211\u8C08\u4E00\u8C08\uFF0C\u4F60\u613F\u610F\u5C1D\u8BD5\u5417\uFF1F"
  - "\u5948\u7279\u5148\u751F\uFF0C\u6211\u4E0D\u77E5\u9053\u4F60\u662F\u5982\u4F55\u5F97\u77E5\u7684......"
  - "\u5FFD\u7136\uFF0C\u4F60\u5728\u5979\u8BDD\u8BED\u7684\u505C\u987F\u4E4B\u95F4\u542C\u5230\u4E86\u4E00\u79CD\u5947\u602A\u7684\u98A4\u6296\u3002\u90A3\u662F\u555C\u6CE3\uFF0C\u5979\u5728\u54ED\u6CE3\u7684\u65F6\u5019\u5C06\u542C\u7B52\u62FF\u8FDC\u4E86\u3002"
  - "\u72ED\u7A84\u7684\u94C1\u9053\u516C\u5BD3\u5185\uFF0C\u53A8\u623F\u4E0E\u5BA2\u5385\u4E4B\u95F4\u7684\u5899\u58C1\u4E0A\u6709\u4E00\u67B6\u62E8\u53F7\u7535\u8BDD\uFF0C\u6C89\u91CD\u7684\u9ED1\u8272\u542C\u7B52\u65C1\u8D34\u7740\u4E00\u5F20\u4FBF\u7B7E\u7EB8\uFF0C\u624B\u6284\u7684\u4E00\u6392\u6392\u53F7\u7801\u88AB\u4E00\u4E2A\u63A5\u4E00\u4E2A\u5730\u7528\u529B\u5212\u6389\u3002\u6709\u4E00\u4E24\u4E2A\u88AB\u91CD\u65B0\u6284\u5199\uFF0C\u7136\u540E\u518D\u6B21\u88AB\u5212\u6389\u3002\u7535\u8BDD\u5DF2\u7ECF\u6B20\u8D39\u505C\u673A\u3002\r\n\r\n\u53A8\u623F\u684C\u4E0A\u653E\u7740\u4E00\u4E2A\u94DD\u5236\u7684\u7CD6\u7F50\uFF0C\u7528\u4E8E\u5236\u4F5C\u65E9\u9910\u9EA6\u7247\uFF0C\u91CC\u9762\u5DF2\u7ECF\u6CA1\u6709\u7CD6\u7C89\uFF0C\u53EA\u5269\u4E0B\u4E00\u4E9B\u7ED3\u5757\u7684\u767D\u8272\u9897\u7C92\u3002\u7CD6\u7F50\u7684\u4E0B\u9762\u6574\u9F50\u5730\u538B\u7740\u8BB8\u591A\u767D\u8272\u7684\u4FE1\u5C01\uFF1A\u66F4\u4E0B\u9762\u7684\u662F\u623F\u79DF\u50AC\u7F34\u4FE1\uFF0C\u9760\u4E0A\u7684\u662F\u9650\u671F\u642C\u79BB\u901A\u77E5\u3002"
  - "\u505C\u673A\u7684\u7535\u8BDD\u3001\u6B20\u7F34\u7684\u623F\u79DF\uFF0C\u4F60\u77E5\u9053\u5979\u88AB\u8D2B\u7A77\u538B\u5F97\u5598\u4E0D\u8FC7\u6C14\u6765\uFF0C\u5374\u65E0\u6CD5\u60F3\u8C61\u5979\u5177\u4F53\u7684\u5904\u5883\u3002"
  - "\u94C1\u9053\u516C\u5BD3\u7684\u6240\u6709\u623F\u95F4\u5F7C\u6B64\u4E32\u8054\uFF0C\u7EC6\u5C0F\u7684\u58F0\u97F3\u96BE\u4EE5\u963B\u9694\u3002\u5C0F\u7537\u5B69\u8737\u7F29\u5728\u8584\u5899\u540E\u7684\u6298\u53E0\u5E8A\u4E0A\uFF0C\u6BEF\u5B50\u62C9\u5230\u4E0B\u5DF4\u3002\u53A8\u623F\u7684\u706F\u7184\u706D\u4E86\uFF0C\u53EA\u5269\u7089\u7076\u4E0A\u65B9\u4E00\u5C0F\u5757\u53D1\u9EC4\u7684\u5149\u3002\u5979\u7AD9\u5728\u6C34\u69FD\u8FB9\uFF0C\u628A\u6C34\u9F99\u5934\u5F00\u5230\u6700\u7EC6\u7684\u4E00\u7EBF\uFF0C\u8BA9\u6C34\u58F0\u76D6\u4F4F\u5979\u7684\u547C\u5438\u3002\u5979\u4E00\u53EA\u624B\u6491\u7740\u53F0\u9762\uFF0C\u53E6\u4E00\u53EA\u624B\u6309\u4F4F\u5507\u89D2\uFF0C\u7B49\u5F85\u7740\u80F8\u53E3\u7684\u90A3\u9635\u8D77\u4F0F\u8FC7\u53BB\u3002\r\n\r\n\u5979\u542C\u5230\u4E86\u6298\u53E0\u5E8A\u7FFB\u8EAB\u7684\u560E\u5431\u58F0\uFF0C\u5C0F\u7537\u5B69\u542B\u7CCA\u5730\u53EB\u4E86\u4E00\u58F0\u201C\u5988\u5988\u201D\uFF0C\u5979\u7ACB\u523B\u505C\u4E86\u4E0B\u6765\uFF0C\u8FC5\u901F\u5730\u64E6\u8138\u3001\u6E05\u55D3\u5B50\uFF0C\u6362\u4E0A\u90A3\u79CD\u5E73\u9759\u58F0\u97F3\uFF1A\u201C\u4E39\u5C3C\uFF0C\u8981\u559D\u6C34\u5417\uFF1F\u201D"
  - "\u4E0D\u77E5\u4E3A\u4F55\uFF0C\u5979<b>\u6050\u60E7</b>\u8FD9\u4E9B\u75DB\u82E6\u548C\u7EDD\u671B\u6D6E\u4E0A\u5979\u7684\u8868\u9762\u3002\u81F3\u5C11\u4F60\u80FD\u770B\u51FA\u6765\uFF0C\u5979\u7684\u538B\u6291\u5DF2\u7ECF\u6210\u4E3A\u4E00\u79CD\u523B\u5728\u8EAB\u4F53\u91CC\u7684\u53CD\u5C04\u6027\u4E60\u60EF\u3002"
  - "\u53EF\u662F\uFF0C\u4E00\u5C0F\u6BB5\u65F6\u95F4\uFF0C\u8FD9\u4EC0\u4E48\u4E5F\u6539\u53D8\u4E0D\u4E86......"
  - "\u5979\u5DF2\u7ECF\u88AB\u540D\u4E3A\u201C\u8D2B\u56F0\u201D\u7684\u6CE5\u6F6D\u5B8C\u5168\u541E\u6CA1\uFF0C\u65E0\u6CD5\u5598\u606F\u3002"
  - "\u628A\u75DB\u82E6\u54BD\u56DE\u82E6\u6DA9\u7684\u5589\u5499\uFF0C\u662F\u5979\u7684\u4E60\u60EF\u6027\u52A8\u4F5C\u3002"
  - "......\r\n\r\n\u4F60\u4E3A\u4EC0\u4E48\u8FD9\u6837\u8BF4\uFF1F"
