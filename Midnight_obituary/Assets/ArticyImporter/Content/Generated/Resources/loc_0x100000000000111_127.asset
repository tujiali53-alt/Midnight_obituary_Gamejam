  - "\u4F60\u51B3\u5B9A\u5728\u4ECA\u665A\u7ED3\u675F\u81EA\u5DF1\u7684\u751F\u547D\u5417\uFF1F"
  - '......

    

    ......

    

    ............'
  - "\u6211\u660E\u767D\uFF0C\u8FD9\u6539\u53D8\u4E0D\u4E86\u6240\u6709\u90A3\u4E9B\u8BA9\u4F60\u611F\u53D7\u5230\u75DB\u82E6\u548C\u7EDD\u671B\u7684\u4E8B\u60C5\u3002\u4F46\u6211\u4EEC\u8FD8\u53EF\u4EE5\u4E00\u8D77\u60F3\u4E00\u60F3\uFF0C\u601D\u8003\u4E00\u4E0B\u8FD9\u4E2A\u6700\u540E\u7684\u51B3\u5B9A\u3002"
  - "\u4F60\u8BF4\u5F97\u6CA1\u9519\u3002\u53EA\u662F\u5728\u8FD9\u4E00\u5C0F\u6BB5\u65F6\u95F4\u5185\uFF0C\u4F60\u4E5F\u53EF\u4EE5\u544A\u8BC9\u6211\u4F60\u5F88\u7D2F\u3001\u4F60\u5F88\u75DB\u82E6\uFF0C\u8FD9\u6837\u4E5F\u8BB8\u4F1A\u8BA9\u4F60\u7A0D\u5FAE\u597D\u53D7\u4E00\u4E9B\u3002"
  - "\u662F\u7684\uFF0C\u867D\u7136\u6CA1\u6CD5\u6539\u53D8\u4F60\u7684\u56F0\u5883\uFF0C\u4F46\u6216\u8BB8\u4F60\u53EF\u4EE5\u548C\u6211\u8C08\u8C08\u538B\u5728\u4F60\u5FC3\u91CC\u6700\u6C89\u91CD\u7684\u4E8B\u60C5\u3002"
  - "\u662F\u7684\uFF0C\u867D\u7136\u6CA1\u6CD5\u6539\u53D8\u4F60\u7684\u56F0\u5883\uFF0C\u4F46\u6216\u8BB8\u4F60\u53EF\u4EE5\u548C\u6211\u8C08\u8C08\u4ECA\u5929\u53D1\u751F\u4E86\u4EC0\u4E48\u8BA9\u4F60\u505A\u51FA\u4E86\u8FD9\u4E2A\u51B3\u5B9A\u3002"
  - "\u68C0\u67E5\u4EC0\u4E48\uFF1F\u6211\u5DF2\u7ECF\u5168\u90E8\u68C0\u67E5\u8FC7\u4E86\uFF0C\u6240\u6709\u7684\u53EF\u80FD\u6027\u90FD\u6CA1\u4E86\uFF0C\u5DF2\u7ECF\u6CA1\u6709\u4EFB\u4F55\u529E\u6CD5\u4E86\u3002\u4E39\u5C3C\u548C\u6211\uFF0C\u8FD9\u4E2A\u4E16\u754C\u4E0D\u662F\u4E3A\u6211\u4EEC\u8FD9\u6837\u7684\u4EBA\u51C6\u5907\u7684\u3002"
  - "\u8FD9\u662F\u4E00\u53E5\u82E6\u6DA9\u7684\u8BDD\uFF0C\u8FD9\u610F\u5473\u7740\u5979\u4E3A\u4E86\u8FD9\u4E2A\u4E16\u754C\u7684\u67D0\u4E9B\u201C\u89C4\u5219\u201D\u7684\u4E0D\u516C\u800C\u611F\u5230\u75DB\u82E6\u2014\u2014\u800C\u5979\u81EA\u5DF1\u5927\u6982\u5374\u6CA1\u6709\u5BDF\u89C9\u3002\r\n\r\n\u8FD9\u79CD\u82E6\u6DA9\u7684\u6124\u6012\u5F88\u6709\u53EF\u80FD\u4F1A\u6210\u4E3A\u4E00\u4E2A\u4EBA\u63D2\u5411\u5979\u81EA\u8EAB\u7684\u5229\u5203\u3002\r\n\r\n\u641E\u6E05\u695A\u8FD9\u4E9B\u201C\u89C4\u5219\u201D\u662F\u4EC0\u4E48\u3002"
  - "\u8FD9\u662F\u4E00\u53E5\u60B2\u4F24\u7684\u8BDD\uFF0C\u201C\u8FD9\u5C31\u662F\u6211\u4EEC\u4E0D\u5F97\u4E0D\u79BB\u5F00\u8FD9\u4E2A\u4E16\u754C\u7684\u7406\u7531\u201D\u3002\u67D0\u79CD\u6A21\u7CCA\u7684\u611F\u89C9\u5728\u4F60\u7684\u5FC3\u91CC\u8F6C\u77AC\u5373\u901D\u4E86\u3002"
  - "\u6211\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u8BF4\uFF0C\u7D2F\u548C\u75DB\u82E6\u90FD\u4E0D\u662F\u6211\u80FD\u60F3\u7684\u4E8B\u60C5\uFF0C\u8FD9\u53EA\u662F......\u6CA1\u7528\u3002\u5B9E\u9645\u4E0A\uFF0C\u4E00\u5207\u90FD\u6CA1\u7528\uFF0C\u5DF2\u7ECF\u4E0D\u53EF\u80FD\u6709\u4EFB\u4F55\u529E\u6CD5\u4E86\u3002\u4E39\u5C3C\u548C\u6211\uFF0C\u8FD9\u4E2A\u4E16\u754C\u4E0D\u662F\u4E3A\u6211\u4EEC\u8FD9\u6837\u7684\u4EBA\u51C6\u5907\u7684\u3002"
  - "......\u662F\u4E39\u5C3C\u3002\u65E0\u8BBA\u518D\u600E\u4E48\u6837\u52AA\u529B\uFF0C\u90FD\u662F\u4E0D\u53EF\u80FD\u9760\u6211\u8BA9\u4ED6\u597D\u597D\u957F\u5927\u7684\uFF0C\u6211\u4E0D\u4F1A\u6709\u4EFB\u4F55\u529E\u6CD5\u4E86\u3002\u4E39\u5C3C\u548C\u6211\uFF0C\u8FD9\u4E2A\u4E16\u754C\u4E0D\u662F\u4E3A\u6211\u4EEC\u8FD9\u6837\u7684\u4EBA\u51C6\u5907\u7684\u3002"
  - "\u4ECA\u5929\uFF1F\u4ECA\u5929\u548C\u6628\u5929\u6CA1\u6709\u4EC0\u4E48\u533A\u522B\uFF0C\u4E00\u76F4\u90FD\u5728\u53D1\u751F\u76F8\u540C\u7684\u4E8B\u60C5\uFF0C\u53EA\u662F\u4ECA\u5929\u6211\u610F\u8BC6\u5230\u518D\u4E5F\u6CA1\u6709\u4EFB\u4F55\u529E\u6CD5\u4E86\uFF0C\u4E0D\u4F1A\u6709\u7684\u3002\u4E39\u5C3C\u548C\u6211\uFF0C\u8FD9\u4E2A\u4E16\u754C\u4E0D\u662F\u4E3A\u6211\u4EEC\u8FD9\u6837\u7684\u4EBA\u51C6\u5907\u7684\u3002"
  - "\u53EF\u4EE5\u544A\u8BC9\u6211\u53D1\u751F\u4EC0\u4E48\u4E8B\u4E86\u5417\uFF1F"
  - "\u4E09\u5929\u4E4B\u540E\uFF0C\u4ED6\u4EEC\u5C31\u4F1A\u91C7\u53D6\u5F3A\u5236\u63AA\u65BD\uFF0C\u8BA9\u4E39\u5C3C\u548C\u6211\u4ECE\u516C\u5BD3\u91CC\u79BB\u5F00\u3002\r\n\r\n\u8FD9\u6B21\u4E00\u5B9A\u662F\u771F\u7684\uFF0C\u56E0\u4E3A\u8FD9\u662F\u4ED6\u4EEC\u7B2C\u4E8C\u6B21\u53D1\u9650\u671F\u642C\u79BB\u7684\u901A\u77E5\u4E86\u3002"
  - "\u5177\u4F53\u662F\u4EC0\u4E48\u65F6\u5019\u6536\u5230\u7684\u901A\u77E5\uFF1F"
  - "\u6211\u4EE5\u4E3A\u53EA\u8981\u6211\u62FC\u547D\u5730\u53BB\u627E\uFF0C\u4E00\u5B9A\u80FD\u627E\u5230\u529E\u6CD5\uFF0C\u53EF\u662F......\u4EC0\u4E48\u529E\u6CD5\u4E5F\u6CA1\u6709\uFF0C\u5BF9\u6211\u6765\u8BF4\uFF0C\u600E\u4E48\u52AA\u529B\u90FD\u662F\u6CA1\u7528\u7684\u3002"
  - "\u542C\u8D77\u6765\u4F60\u5C1D\u8BD5\u4E86\u5F88\u591A......\u4F46\u5B83\u4EEC\u90FD\u884C\u4E0D\u901A\uFF1F"
  - "\u6211\u53BB\u201C\u672C\u987F\u201D\u4E5E\u6C42\u4ED6\u4EEC\u518D\u8BA9\u6211\u505A\u4E00\u4E2A\u6708......\u6211\u53BB\u6C42\u4E86AFDC\u7684\u4EBA......\u6211\u53BB\u7687\u540E\u533A\u627E\u6211\u7684\u59D0\u59D0\uFF0C\u5979\u5E2E\u4E0D\u4E86\u6211......\u9664\u4E86\u623F\u79DF\uFF0C\u8FD8\u6709\u4E39\u5C3C\u7684\u5348\u9910\u8D39\u3001\u8BFE\u672C......\u54EA\u513F\u4E5F\u4E0D\u80AF\u96C7\u4E00\u4E2A\u5355\u4EB2\u6BCD\u4EB2\u505A\u517C\u804C.....\u6211\u60F3\u53BB\u7535\u8BDD\u4EAD\u7ED9\u7231\u4E3D\u4E1D\u6253\u4E2A\u7535\u8BDD\uFF0C\u53EF\u662F\u6211\u5DEE10\u5206\u94B1......"
  - "\u6731\u8FEA\uFF0C\u51B7\u9759\u4E0B\u6765\uFF0C\u8981\u4E0D\u8981\u8BD5\u4E00\u4E0B\u6DF1\u547C\u5438\uFF1F"
