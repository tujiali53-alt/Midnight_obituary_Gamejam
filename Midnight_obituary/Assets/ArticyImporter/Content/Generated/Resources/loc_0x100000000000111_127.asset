  - "\u4E0D......\u4ED6\u4EEC\u5DF2\u7ECF\u662F\u8FD9\u4E2A\u4E16\u754C\u4E0A\u6700\u540E\u6709\u53EF\u80FD\u5E2E\u5FD9\u7684......"
  - "\u5979\u5931\u53BB\u4E86\u5979\u7684\u58F0\u97F3\uFF0C\u88AB\u6CEA\u6C34\u6D78\u6E7F\u7684\u547C\u5438\u5728\u767D\u832B\u832B\u566A\u58F0\u4E2D\u65F6\u9690\u65F6\u73B0\u3002\r\n\r\n\u4F60\u5FC5\u987B\u518D\u6B21\u5C1D\u8BD5\u3002"
  - "\u6731\u8FEA\uFF0C\u542C\u7740\u6211\u7684\u58F0\u97F3\uFF0C\u6DF1\u547C\u5438\uFF0C\u547C......"
  - "\u547C......"
  - "\u51E0\u6B21\u6DF1\u547C\u5438\u4E4B\u540E\uFF0C\u5979\u7A0D\u5FAE\u5E73\u9759\u4E86\u4E0B\u6765\u3002"
  - "\u201C\u672C\u987F\u201D\uFF0C\u90A3\u662F\u4F60\u5DE5\u4F5C\u7684\u5730\u65B9\u5417\uFF1F"
  - AFDC......
  - "\u4F60\u53BB\u627E\u4F60\u59D0\u59D0\u5E2E\u5FD9\uFF0C\u5979\u4F4F\u5728\u7687\u540E\u533A\uFF1F"
  - "\u8FD9\u4E2A\u95EE\u9898\u53EF\u80FD\u6709\u70B9\u7A81\u7136......\u4E39\u5C3C\u4ED6\u73B0\u5728\u600E\u4E48\u6837\uFF1F"
  - "\u4F60\u521A\u624D\u63D0\u5230\uFF0C\u4F60\u665A\u4E0A\u60F3\u8981\u6253\u4E00\u4E2A\u7535\u8BDD\uFF1F"
  - "\u542C\u8D77\u6765\u4F60\u628A\u81EA\u5DF1\u8017\u5C3D\u4E86\uFF0C\u6BCF\u4E00\u6B21\u5C1D\u8BD5\u90FD\u7ED9\u81EA\u5DF1\u5E26\u6765\u4E86\u66F4\u591A\u75DB\u82E6\uFF0C\u662F\u8FD9\u6837\u4E48\uFF1F"
  - "\u8FD9\u662F\u4F60\u7684\u622A\u6B62\u65E5\u671F\uFF0C\u5BF9\u4E48\uFF1F"
  - "\u5982\u679C\u6CA1\u6CD5\u5728\u8FD9\u4E4B\u524D\u89E3\u51B3\u6240\u6709\u4E8B\u60C5\u7684\u8BDD......"
  - "\u4E09\u5929\u524D\uFF0C\u4ED6\u4EEC\u544A\u8BC9\u6211\u53EA\u6709\u4E00\u5468\u7684\u65F6\u9650\u3002"
  - "\u6211\u628A\u5269\u4E0B\u7684\u6BCF\u4E00\u5206\u786C\u5E01\u90FD\u5728\u684C\u5B50\u4E0A\u6392\u597D\uFF0C\u6700\u540E\u8FD8\u662F\u5DEE10\u5206\u94B1......"
  - "\u672C\u987F\u98DF\u54C1\u4E2D\u5FC3\uFF0C\u6211\u66FE\u7ECF\u5728\u90A3\u91CC\u505A\u517C\u804C\u3002\r\n\r\n\u4E94\u4E2A\u6708\u524D\uFF0C\u4ED6\u4EEC\u628A\u6240\u6709\u517C\u804C\u5DE5\u64A4\u6389\u4E86\uFF0C\u6211\u5931\u53BB\u4E86\u6240\u6709\u6536\u5165\uFF0C\u4E8B\u60C5\u4ECE\u90A3\u65F6\u5019\u5F00\u59CB\u53D8\u5F97\u65E0\u6CD5\u633D\u56DE\u3002"
  - "\u662F\u7684\u3002\u4E5D\u6708\u4EFD\u5F00\u59CB\uFF0C\u6709\u4E00\u4E9B\u7D27\u6025\u8865\u52A9\u88AB\u53D6\u6D88\u4E86\u3002\u5B69\u5B50\u7684\u8865\u52A9\u6539\u6210\u4E86\u5B63\u5EA6\u53D1\u653E\uFF0C\u5341\u4E8C\u6708\u624D\u80FD\u9886\u5230\u3002\r\n\r\n\u8FD9\u8BA9\u6240\u6709\u4E8B\u90FD\u53D8\u5F97\u66F4\u7CDF\u4E86\u3002"
  - "\u5979\u8BF4\u7684\u662F\uFF1A<i>\u629A\u517B\u672A\u6210\u5E74\u513F\u7AE5\u5BB6\u5EAD\u63F4\u52A9</i>\uFF08Aid
    to Families with Dependent Children\uFF09\u3002"
  - "\u6211\u4E00\u76F4\u5728\u5C1D\u8BD5\u627E\u4E2A\u65B0\u5DE5\u4F5C\uFF0C\u4F46\u6CA1\u6709\u4EBA\u613F\u610F\u96C7\u6211\u3002\r\n\r\n\u4ED6\u4EEC\u8981\u627E\u7684\u662F\u4E00\u4E2A\u201C\u66F4\u53EF\u9760\u7684\u4EBA\u201D\u3002\u201C\u4F60\u6709\u4E2A\u5B69\u5B50\u9700\u8981\u7167\u987E\uFF0C\u5C0F\u5BB6\u4F19\u9700\u8981\u4F60\u53EF\u4E0D\u4F1A\u770B\u662F\u4EC0\u4E48\u65F6\u5019\u662F\u5427\u201D\uFF0C\u51E0\u4E4E\u6BCF\u4E2A\u4EBA\u90FD\u8FD9\u4E48\u8BF4\u3002"
  - "\u6162\u6162\u6765\uFF0C\u4F60\u53EF\u4EE5\u4E00\u70B9\u70B9\u544A\u8BC9\u6211\u3002"
  - "\u542C\u8D77\u6765\u4F60\u89C9\u5F97\u8FD9\u4E9B\u662F\u4E0D\u516C\u5E73\u7684\u3002"
  - "\u672C\u987F\u7684\u5DE5\u4F5C\u6CA1\u4E86\uFF0C\u65B0\u7684\u517C\u804C\u4E5F\u627E\u4E0D\u5230\uFF0C\u6211\u9760\u4EC0\u4E48\u624D\u80FD\u6D3B\u4E0B\u53BB......"
  - "\u5E02\u9762\u4E0A\u7684\u5DE5\u4F5C\u9700\u8981\u7684\u65F6\u95F4\u8981\u6C42\u662F\u4F60\u4E0D\u53EF\u80FD\u505A\u5230\u7684\uFF0C\u6240\u4EE5\u4F60\u611F\u89C9\u6C42\u804C\u8FD9\u6761\u8DEF\u88AB\u5835\u6B7B\u4E86\uFF0C\u662F\u4E48\uFF1F"
  - "\u6CA1\u6709\u85AA\u6C34\uFF0C\u5404\u79CD\u5F00\u9500\u53D8\u6210\u65E0\u6CD5\u586B\u8865\u7684\u8D1F\u62C5\uFF0C\u6240\u4EE5\u4F60\u611F\u5230\u672A\u6765\u6CA1\u529E\u6CD5\u7EE7\u7EED\u4E0B\u53BB\uFF0C\u662F\u4E48\uFF1F"
  - "\u6240\u6709\u7684\u7A9F\u7ABF\u90FD\u5728\u8D8A\u53D8\u8D8A\u5927\uFF0C\u627E\u4E0D\u5230\u5DE5\u4F5C\u7684\u8BDD......\u4E0D\uFF0C\u6211\u5FC5\u987B\u627E\u5230\u5DE5\u4F5C\u624D\u884C\uFF0C\u53EF\u662F\u6CA1\u6709\u4EBA\u4F1A\u96C7\u6211\u7684\uFF0C\u6CA1\u6709\u4EBA......"
  - "\u6211\u4E0D\u662F\u4E00\u4E2A\u201C\u53EF\u9760\u201D\u7684\u4EBA\u5417\u2014\u2014\u5979\u8FD9\u6837\u626A\u5FC3\u81EA\u95EE\u3002\u7136\u800C\u4F46\u5F53\u4EBA\u4EEC\u90A3\u6837\u8BF4\u65F6\uFF0C\u201C\u6211\u4EEC\u9700\u8981\u4E00\u4E2A\u53EF\u9760\u7684\u4EBA\u201D\uFF0C\u4ED6\u4EEC\u5E76\u4E0D\u771F\u7684\u5173\u5FC3\u8FD9\u9879\u54C1\u8D28\u3002\r\n\r\n\u4F60\u627E\u5230\u4E86\u4E00\u4E2A\u6B63\u5728\u6298\u78E8\u5979\u7684\u201C\u89C4\u5219\u201D\u3002"
  - "\u8BB0\u5F97\u544A\u8BC9\u5979\u3002"
  - "\u542C\u8D77\u6765\u4ED6\u4EEC\u53E3\u4E2D\u7684\u53EF\u9760\u4EC5\u4EC5\u662F\u6CA1\u6709\u5B69\u5B50\uFF0C\u4F46\u4ED6\u4EEC\u6839\u672C\u4E0D\u5173\u5FC3\u4F60\u662F\u4E0D\u662F\u4E00\u4E2A\u771F\u7684\u662F\u4E00\u4E2A\u53EF\u9760\u7684\u4EBA\uFF0C\u5BF9\u4E48\uFF1F"
  - "\u662F\u7684\uFF0C\u6211\u66FE\u7ECF\u5F88\u53EF\u9760......\u4ED6\u4EEC\u4E00\u542C\u8BF4\u6211\u9700\u8981\u7167\u987E\u5B69\u5B50\uFF0C\u5C31\u6446\u51FA\u4E0D\u8010\u70E6\u7684\u6001\u5EA6\uFF0C\u597D\u50CF\u6211\u76F8\u5F53\u9760\u4E0D\u4F4F\uFF0C\u662F\u4E2A\u6CA1\u6CD5\u4FE1\u4EFB\u7684\u4EBA......"
  - "\u4E0D\uFF0C\u4E0D\u662F\u66FE\u7ECF\uFF0C\u4F60\u540C\u65F6\u5DE5\u4F5C\u548C\u7167\u987E\u4E39\u5C3C\uFF0C\u76F8\u4FE1\u6211\uFF0C\u4F60\u4E00\u76F4\u5F88\u53EF\u9760\u3002"
  - "\u8C22\u8C22......\u4F46\u662F\u8FD9\u4E0D\u80FD\u6539\u53D8\u4EFB\u4F55\u4E8B......"
  - "\u4F60\u53BB\u4E86\u798F\u5229\u529E\u516C\u5BA4\uFF1F"
  - "\u4ED6\u4EEC\u53EA\u8981\u80FD\u4E0A\u665A\u73ED\u7684\u4EBA\uFF0C\u6211......\u6211\u4E0D\u53EF\u80FD\u628A\u4E39\u5C3C\u4E00\u4E2A\u4EBA\u4E22\u5728\u5BB6\u91CC\u5230\u665A\u4E0A\u5341\u4E8C\u70B9\uFF0C\u5948\u7279\u5148\u751F\uFF0C\u8FD9\u5BF9\u6211\u800C\u8A00\u4E0D\u53EF\u80FD......"
  - "\u6211\u53BB\u4E86\u5F88\u591A\u8D9F\uFF0C\u60F3\u81F3\u5C11\u80FD\u7533\u9886\u5230\u4E00\u70B9\u513F\u3002\u4F46\u662F\u4ED6\u4EEC\u8BF4\u653F\u7B56\u521A\u51FA\u6765\uFF0C\u6CA1\u6CD5\u901A\u878D\u3002"
  - "\u4F60\u73B0\u5728\u5C31\u9700\u8981\u94B1\uFF0C\u4F46\u662F\u653F\u7B56\u8BA9\u4F60\u4E0D\u5F97\u4E0D\u7B49\u5230\u51E0\u4E2A\u6708\u540E\u624D\u80FD\u83B7\u5F97\u5E2E\u52A9\u3002"
  - "\u5C3D\u7BA1\u4F60\u7B26\u5408\u7533\u9886\u8D44\u8D28\uFF0C\u4F46\u662F\u6392\u671F\u8868\u4E0D\u5141\u8BB8\u4F60\u5F97\u5230\u5B9E\u9645\u7684\u5E2E\u52A9\uFF0C\u4F60\u89C9\u5F97\u8FD9\u5E76\u4E0D\u5408\u7406\uFF0C\u5BF9\u5417\uFF1F"
  - "\u6211\u7B49\u4E0D\u4E86\u51E0\u4E2A\u6708......"
  - "\u53CD\u590D\u88AB\u62D2\u7EDD\uFF0C\u8FD9\u4E00\u5B9A\u8BA9\u4F60\u611F\u5230\u5F88\u6CAE\u4E27\u3002"
  - "\u6CAE\u4E27\u662F\u6CA1\u6709\u7528\u7684\uFF0C\u6211\u6539\u53D8\u4E0D\u4E86\u522B\u4EBA\u5B9A\u597D\u7684\u653F\u7B56......"
  - "\u662F\u554A\uFF0C\u6211\u7B26\u5408\uFF0C\u7A97\u53E3\u540E\u9762\u7684\u4EBA\u4E5F\u77E5\u9053\u662F\u8FD9\u4E48\u56DE\u4E8B\uFF0C\u4F46\u662F\u6211\u80FD\u4ECE\u90A3\u91CC\u5F97\u5230\u7684\u53EA\u6709\u201C\u8BF7\u60A8\u5148\u56DE\u53BB\u5427\u201D\uFF0C\u201C\u73B0\u5728\u6211\u4EEC\u5E2E\u4E0D\u4E86\u60A8\u201D......"
  - "\u8FD9\u4E5F\u662F\u4E00\u4E2A\u8DB3\u4EE5\u8BA9\u5979\u5907\u53D7\u6298\u78E8\u7684\u201C\u89C4\u5219\u201D\u3002"
  - "\u8FD9\u662F\u4E00\u9879\u4E0D\u5408\u7406\u7684\u653F\u7B56\uFF0C\u8BA9\u8BB8\u591A\u7B26\u5408\u8D44\u8D28\u7684\u4EBA\u65E0\u6CD5\u5B9E\u9645\u4E0A\u6709\u6548\u5730\u83B7\u5F97\u5E2E\u52A9\uFF0C\u906D\u5230\u4E86\u5927\u8303\u56F4\u7684\u6297\u8BAE\u3002"
  - "\u8C22\u8C22\u4F60\u544A\u8BC9\u6211\u8FD9\u4E9B\uFF0C\u8FD9\u89E3\u91CA\u4E86\u5F88\u591A\u3002\u6211\u4EEC\u518D\u804A\u804A\u522B\u7684\u5427\u3002"
  - "\u662F\u7684\uFF0C\u5730\u94C1\u548C\u793C\u7269\u603B\u5171\u82B1\u4E862\u7F8E\u514340\u5206\uFF0C\u6211\u5E0C\u671B\u7231\u4E3D\u4E1D\u80FD\u501F\u6211\u4E00\u4E9B\u94B1\uFF0C\u8BA9\u6211\u548C\u4E39\u5C3C\u5148\u6491\u5230\u6708\u5E95......\u6211\u7ED9\u5979\u5E26\u4E86\u5979\u559C\u6B22\u7684\u76C6\u683D\uFF0C\u56E0\u4E3A\u6211\u60F3\u5230\uFF0C\u5982\u679C\u501F\u4E86\u94B1\uFF0C\u6211\u5927\u6982\u77ED\u65F6\u95F4\u5185\u8FD8\u4E0D\u4E0A......"
  - "\u5979\u62D2\u7EDD\u4E86\uFF0C\u5979\u6CA1\u6709\u591A\u4F59\u7684\u94B1\u6765\u5E2E\u6211\u3002\u5979\u7ED9\u4E86\u6211\u4E00\u888B\u65E7\u8863\u670D\uFF0C\u8BF4\u7B49\u4E39\u5C3C\u518D\u5927\u4E00\u70B9\u53EF\u4EE5\u7A7F......"
  - "\u6211\u6CA1\u6709\u670B\u53CB\uFF0C\u5979\u662F\u4E16\u754C\u4E0A\u6700\u540E\u4E00\u4E2A\u80FD\u5E2E\u6211\u7684\u4EBA\u4E86\u3002"
  - "[chapterjudith.calling_her_by]\uFF0C\u867D\u7136\u7231\u4E3D\u4E1D\u6CA1\u6CD5\u5728\u94B1\u4E0A\u9762\u5E2E\u52A9\u4F60\uFF0C\u4F46\u4F60\u89C9\u5F97\u5979\u613F\u610F\u5E2E\u4F60\u4E00\u4E9B\u522B\u7684\u5FD9\u4E48\uFF1F"
  - "\u8FD9\u4E2A\u5973\u4EBA\u5728\u8D70\u6295\u65E0\u8DEF\u7684\u7EDD\u671B\u4E2D\u653E\u5927\u4E86\u501F\u4E0D\u5230\u94B1\u7684\u5931\u671B\u611F\uFF0C\u5F7B\u5E95\u5173\u95ED\u4E86\u5411\u59D0\u59D0\u5BFB\u6C42\u5E2E\u52A9\u7684\u901A\u9053\u3002\r\n\r\n\u5B9E\u9645\u4E0A\uFF0C\u7231\u4E3D\u4E1D\u4ECD\u7136\u6709\u53EF\u80FD\u613F\u610F\u5E2E\u52A9\u5979\uFF0C\u6BD4\u5982\u5BF9\u5979\u7684\u8FC7\u6FC0\u884C\u4E3A\u8FDB\u884C\u5E72\u9884\uFF0C\u6216\u8005\u5728\u665A\u4E0A\u7167\u770B\u4E39\u5C3C\u7B49\u7B49\u3002"
  - "\u62B1\u6B49\uFF0C\u6211\u4E0D\u8BE5\u548C\u4F60\u62B1\u6028\u8FD9\u4E48\u591A\u7684......\u8FD9\u4E9B\u5E76\u4E0D\u662F\u4F60\u5E94\u8BE5\u627F\u53D7\u7684\u70E6\u607C\u3002"
  - "\u4F60\u613F\u610F\u544A\u8BC9\u6211\u8FD9\u4E9B\uFF0C\u662F\u5F88\u597D\u7684\u4E8B\u60C5\uFF0C\u8FD9\u6837\u6211\u624D\u80FD\u5E2E\u4F60\u4E00\u8D77\u5F04\u6E05\u695A\u662F\u4E0D\u662F\u771F\u7684\u8981\u7ACB\u523B\u505A\u8FD9\u4E2A\u6700\u540E\u7684\u51B3\u5B9A\u3002"
  - "\u65E0\u8BBA\u4F60\u662F\u5426\u76F8\u4FE1\uFF0C\u542C\u4F60\u8BF4\u8FD9\u4E9B\u4E5F\u662F\u6211\u6240\u5E0C\u671B\u7684\u3002\u6211\u5411\u4F60\u4FDD\u8BC1\u4F60\u7684\u8BDD\u4E0D\u4F1A\u7ED9\u6211\u589E\u52A0\u70E6\u607C\u3002"
  - "\u597D\u5427......\u6211\u4EEC\u8BF4\u5230\u54EA\u4E86\uFF1F"
  - "\u5973\u4EBA\u7684\u58F0\u97F3\u6D88\u5931\u4E86\uFF0C\u7A0D\u5FAE\u6709\u4E9B\u51CC\u4E71\u7684\u547C\u5438\u58F0\u50CF\u591C\u665A\u7801\u5934\u8FB9\u7684\u6F6E\u6C34\uFF0C\u5728\u542C\u7B52\u7684\u5C3D\u5934\u8D77\u4F0F\u3002\r\n\r\n\u4F60\u4EFF\u4F5B\u80FD\u591F\u770B\u5230\uFF0C\u5728\u4E1C\u533A\u67D0\u5EA7\u7816\u697C\u4E0A\u4E00\u6247\u88AB\u6C34\u6E0D\u6591\u9A73\u7684\u7A97\u6237\u91CC\uFF0C\u5973\u4EBA\u56DE\u8FC7\u5934\u53BB\uFF0C\u76EE\u5149\u7A7F\u8FC7\u62E5\u6324\u4E0D\u582A\u7684\u9ED1\u6697\uFF0C\u6C89\u9ED8\u5730\u671B\u5411\u5BA2\u5385\u7684\u5C3D\u5934\u7684\u623F\u95E8\u3002\r\n\r\n\u8FC7\u4E86\u4E00\u4F1A\u513F\uFF0C\u5979\u7684\u58F0\u97F3\u91CD\u65B0\u4ECE\u6F6E\u6C34\u4E2D\u6D6E\u73B0\u51FA\u6765\u3002"
  - "\u4ED6\u7761\u7740\u4E86\u3002\r\n\r\n\u4E39\u5C3C\u7761\u89C9\u5F88\u6C89\uFF0C\u4E0D\u5BB9\u6613\u88AB\u5435\u9192\u3002"
  - "\u4ECA\u665A\u6211\u7ED9\u4E86\u4ED6\u4E00\u5757\u5DE7\u514B\u529B\uFF0C\u8FD8\u7B54\u5E94\u4ED6\u4E00\u8D77\u7761\u5728\u5C0F\u5E8A\u4E0A\uFF0C\u4ED6\u7761\u4E4B\u524D\u4E00\u76F4\u5F88\u9AD8\u5174\u3002"
  - "\u542C\u7B52\u4E2D\u5973\u4EBA\u7684\u58F0\u97F3\u5F00\u59CB\u4E0A\u626C\u3001\u626D\u66F2\u3001\u98D8\u52A8\u3002"
  - "\u4ED6\u672C\u6765\u60F3\u8981\u628A\u5DE7\u514B\u529B\u5B58\u8D77\u6765\uFF0C\u7559\u5230\u4EE5\u540E\u5403\uFF0C\u6211\u544A\u8BC9\u4ED6\u6211\u4F1A\u518D\u7ED9\u4ED6\u4E70\u7684\uFF0C\u4ED6\u624D\u5F88\u820D\u4E0D\u5F97\u5730\u5403\u6389\u4E86\u3002"
  - "\u6211\u662F\u5168\u4E16\u754C\u6700\u6CA1\u7528\u7684\u5988\u5988\uFF0C\u6211\u4FDD\u62A4\u4E0D\u4E86\u4ED6\uFF0C\u6211\u8FDE\u4E00\u4E2A\u5B69\u5B50\u6700\u57FA\u672C\u7684\u9700\u8981\u90FD\u4E0D\u80FD\u5E26\u7ED9\u4ED6\u3002"
  - "[chapterjudith.calling_her_by]\uFF0C\u4E00\u4E2A\u7CBE\u75B2\u529B\u5C3D\u7684\u6BCD\u4EB2\uFF0C\u4E0D\u7B49\u4E8E\u4E00\u4E2A\u6CA1\u7528\u7684\u6BCD\u4EB2\uFF0C\u522B\u628A\u5B83\u4EEC\u5F53\u6210\u4E00\u56DE\u4E8B\u3002"
  - "\u6211\u539F\u672C\u60F3\u7ED9\u6211\u59D0\u59D0\u6253\u4E2A\u7535\u8BDD\uFF0C\u4F46\u662F\u6CA1\u6709\u8DB3\u591F\u7684\u7535\u8BDD\u8D39\u3002"
  - "\u4E0D\u8FC7\u4E5F\u6CA1\u6709\u90A3\u4E48\u91CD\u8981\uFF0C\u6211\u4EEC\u6CA1\u6709\u4EB2\u8FD1\u5230\u90A3\u79CD\u5730\u6B65\u3002\r\n\r\n\u6211\u7684\u79BB\u5F00\u4E0D\u4F1A\u7ED9\u4EC0\u4E48\u4EBA\u5E26\u6765\u8D1F\u62C5\uFF0C\u79BB\u5F00\u540E\uFF0C\u4E5F\u4E0D\u518D\u4F1A\u6210\u4E3A\u4EFB\u4F55\u4EBA\u7684\u8D1F\u62C5\u4E86\u3002"
  - "[chapterjudith.calling_her_by]\uFF0C\u5148\u522B\u7ED9\u4ED6\u90A3\u4E9B\u66F4\u597D\u7684\u4E1C\u897F\u3002\u4F60\u8FD8\u53EF\u4EE5\u7ED9\u4ED6\u5F88\u591A\uFF0C\u4F60\u53EF\u4EE5\u7ED9\u4ED6\u65F6\u95F4\uFF0C\u8FD8\u53EF\u4EE5\u7ED9\u4ED6\u4E00\u4E2A\u4F60\u6CA1\u6709\u62E7\u5F00\u7164\u6C14\u7684\u623F\u95F4\uFF0C\u8FD8\u53EF\u4EE5\u7ED9\u4ED6\u4E00\u4E2A\u8FD8\u6D3B\u7740\u5750\u5728\u7535\u8BDD\u65C1\u8FB9\u7684\u5988\u5988\u3002"
  - "......\r\n\r\n\u6211\u4F1A\u5C1D\u8BD5......"
  - "......\r\n\r\n\u5948\u7279\u5148\u751F\uFF0C\u6211\u660E\u767D\u4F60\u7684\u597D\u5FC3\uFF0C\u4F46\u8FD9\u53EA\u662F\u6587\u5B57\u6E38\u620F\uFF0C\u6CA1\u6709\u4EC0\u4E48\u610F\u4E49......"
  - "\u6211......\u786E\u5B9E\u5DF2\u7ECF\u7CBE\u75B2\u529B\u7AED\u4E86......"
  - "\u7231\u4E3D\u4E1D\u662F\u5426\u4F1A\u4E3A\u4F60\u7684\u79BB\u5F00\u611F\u5230\u96BE\u8FC7\uFF0C\u81F3\u5C11\u4F60\u4E0D\u80FD\u66FF\u5979\u4E0B\u7ED3\u8BBA\uFF0C\u5BF9\u5417\uFF1F"
  - "[chapterjudith.calling_her_by]\uFF0C\u6211\u6240\u542C\u5230\u7684\u53EA\u662F\u4F60\u56E0\u4E3A\u65E0\u6CD5\u83B7\u5F97\u5E2E\u52A9\u800C\u611F\u53D7\u5230\u7684\u75DB\u82E6\uFF0C\u8FD9\u4E0D\u7B49\u540C\u4E8E\u4F60\u4E0D\u5E94\u8BE5\u5B58\u5728\uFF0C\u5BF9\u5417\uFF1F"
  - "\u7535\u8BDD\u7684\u53E6\u4E00\u7AEF\u9677\u5165\u4E86\u6C89\u9ED8\u3002\u4F46\u5979\u81F3\u5C11\u6CA1\u6709\u53CD\u9A73\u4F60\u3002\r\n\r\n\u73B0\u5728\uFF0C\u4F60\u5E94\u8BE5\u63A5\u7740\u8BF4\u4E9B\u4EC0\u4E48\u3002"
  - "\u5217\u4E3E\u8D8A\u6765\u8D8A\u8FDF\u6EDE\uFF0C\u6700\u540E\u53D8\u6210\u4E86\u54ED\u6CE3\u3002\u4F60\u7B2C\u4E00\u6B21\u542C\u5230\u5979\u54ED\u6CE3\u7684\u58F0\u97F3\u3002\u53E3\u8154\u4E2D\u7684\u6742\u8D28\u50CF\u4E00\u6839\u6C99\u54D1\u7684\u7434\u5F26\u5728\u5979\u7684\u5589\u7BA1\u4E2D\u632F\u52A8\uFF0C\u968F\u7740\u54ED\u58F0\u53D1\u51FA\u4F4E\u6C89\u7684\u548C\u9E23\u3002\r\n\r\n\u7535\u8BDD\u5C31\u5728\u53A8\u623F\u8FB9\uFF0C\u5979\u79BB\u7164\u6C14\u4E0D\u8FDC\u3002\u8FD9\u5F88\u5371\u9669\uFF0C\u4F60\u5FC5\u987B\u5E2E\u52A9\u5979\u51B7\u9759\u4E0B\u6765\u3002"
  - "\u5979\u7684\u58F0\u97F3\u56E0\u4E3A\u6050\u60E7\u548C\u7EDD\u671B\u800C\u98A4\u6296\u7740\u3002"
  - "\u4F60\u662F\u6307\u4EC0\u4E48......\uFF1F"
  - "\u5979\u7684\u58F0\u97F3\u6709\u4E9B\u72B9\u8C6B\u3002\r\n\r\n\u4F60\u660E\u767D\u5979\u5DF2\u7ECF\u9886\u609F\u4E86\u4F60\u7684\u610F\u601D\uFF0C\u4F46\u5979\u8FD8\u4E0D\u6562\u786E\u4FE1\u3002\u5979\u4E00\u76F4\u4E60\u60EF\u4E8E\u522B\u4EBA\u544A\u8BC9\u5979\uFF0C\u8FD9\u4E00\u5207\u90FD\u662F\u5979\u81EA\u5DF1\u7684\u9519\u3002"
  - "\u4EC5\u4EC5\u56E0\u4E3A\u662F\u5355\u4EB2\u5988\u5988\u5C31\u62D2\u7EDD\u96C7\u4F63\u4F60\u3001\u5E94\u8BE5\u5E2E\u52A9\u5230\u4F60\u7684\u8865\u52A9\u5374\u4EFB\u7531\u4F60\u88AB\u903C\u4E0A\u7EDD\u8DEF\uFF0C\u8FD8\u6709......"
  - "\u5979\u5728\u7B49\u4F60\u63A5\u7740\u8BF4\u4E0B\u53BB\u3002"
  - "\u5C1D\u8BD5\u4E86\u6240\u6709\u7684\u53EF\u80FD\u6027\u5374\u4F9D\u7136\u65E0\u8DEF\u53EF\u8D70\u7684\u8FD9\u4E2A\u793E\u4F1A\uFF0C\u4F60\u672C\u6765\u671F\u5F85\u5B83\u662F\u4E00\u4E2A\u80FD\u6709\u4F60\u548C\u4E39\u5C3C\u4E00\u5E2D\u5BB9\u8EAB\u4E4B\u5904\u7684\u5730\u65B9\u3002"
  - "\u5979\u6CA1\u6709\u56DE\u7B54\u3002\u4F60\u9690\u9690\u80FD\u542C\u51FA\uFF0C\u5979\u54ED\u5F97\u5F88\u5389\u5BB3\u3002\r\n\r\n\u73B0\u5728\u7B49\u4E00\u4F1A\u513F\uFF0C\u7B49\u5F85\u5979\u5F00\u53E3\u3002"
  - "\u8FD9\u4E0D\u516C\u5E73\uFF0C\u8FD9\u53EA\u662F......\u4E0D\u516C\u5E73......"
  - "[chapterjudith.calling_her_by]\uFF0C\u4F60\u505A\u51FA\u7684\u8FD9\u4E2A\u51B3\u5B9A\uFF0C\u54EA\u6015\u53EA\u662F\u4E00\u70B9\uFF0C\u4F60\u6709\u6CA1\u6709\u60F3\u8981\u544A\u8BC9\u8FD9\u4E2A\u793E\u4F1A\uFF0C\u5B83\u5E76\u4E0D\u516C\u5E73\uFF1F"
  - "\u6211\u5E76\u4E0D\u662F\u60F3\u5411\u8C01\u8BC1\u660E\u4EC0\u4E48\uFF0C\u4F46\u6211\u771F\u7684\u5DF2\u7ECF\u62FC\u5C3D\u5168\u529B\u4E86\uFF0C\u4E3A\u4E86\u4E39\u5C3C\uFF0C\u4E3A\u4E86\u6211\u81EA\u5DF1\uFF0C\u4F46\u4F9D\u7136\u6CA1\u6709\u4E00\u6247\u6253\u5F00\u7684\u95E8\uFF0C\u6CA1\u6709\u4E00\u70B9\u8BA9\u6211\u7EE7\u7EED\u4E0B\u53BB\u7684\u53EF\u80FD\u6027\uFF0C\u4E8B\u5B9E\u5C31\u662F\u8FD9\u6837......\r\n\r\n\u4E5F\u8BB8\u6709\u4E00\u5C0F\u90E8\u5206\u7684\u6211\uFF0C\u662F\u60F3\u8981\u8FD9\u4E48\u8BF4\u7684\uFF0C\u4F46......\u6211\u53EA\u662F\u6CA1\u529E\u6CD5\u4E86......"
  - "\u4F46\u662F\u5982\u679C\u4F60\u505A\u4E86\u8FD9\u4E2A\u51B3\u5B9A\uFF0C\u90A3\u4E48\u8FD9\u4E00\u5C0F\u90E8\u5206\u7684\u4F60\uFF0C\u5C31\u6CA1\u6CD5\u518D\u5BF9\u4ED6\u4EEC\u8BF4\uFF1A\u4E0D\uFF0C\u8FD9\u4E0D\u516C\u5E73\uFF0C\u8FD9\u4E0D\u662F\u4F60\u7684\u9519\u3002\u4F60\u7684\u58F0\u97F3\u4F1A\u6D88\u5931\uFF0C\u4F60\u7684\u611F\u53D7\u4E5F\u6C38\u8FDC\u88AB\u5B83\u541E\u6CA1\u3002"
  - "\u8FD9\u4E00\u5C0F\u90E8\u5206\u6539\u53D8\u4E0D\u4E86\u4F60\u7684\u60F3\u6CD5\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u4F46\u5B83\u80FD\u8BA9\u4F60\u613F\u610F\u5C11\u8D23\u602A\u81EA\u5DF1\u4E00\u70B9\uFF0C\u8BA9\u4F60\u80FD\u613F\u610F\u5148\u7B49\u5230\u660E\u5929\u5230\u6765\u5417\uFF1F"
  - ......
  - "\u6211\u4F1A\u6309\u7167\u4F60\u8BF4\u7684\u53BB\u505A\uFF0C\u5948\u7279\u5148\u751F\u3002"
  - "\u8C22\u8C22\uFF0C\u665A\u5B89\u3002"
  - "\u4F60\u662F\u6307\u4EC0\u4E48\uFF1F"
  - "\u6BD4\u5982\u6709\u65F6\u5019\u53BB\u63A5\u4E39\u5C3C\u653E\u5B66\uFF0C\u6216\u8005\uFF0C\u6709\u65F6\u5019\u5728\u665A\u4E0A\u7167\u770B\u4E39\u5C3C\uFF0C\u8BA9\u4E39\u5C3C\u4F4F\u5728\u5979\u5BB6\uFF1F"
  - "\u6211......"
  - "\u6211\u6CA1\u6709\u60F3\u5230\u8FD9\u4E9B......\r\n\r\n\u4E5F\u8BB8\uFF0C\u5979\u4E5F\u8BB8\u4F1A\u62D2\u7EDD\uFF0C\u4F46\u4E5F\u6709\u53EF\u80FD\u540C\u610F......"
  - "\u4F60\u613F\u610F\u53BB\u95EE\u5979\u4E48\uFF1F"
  - "\u662F\u7684......\u5929\u5450\uFF0C\u5948\u7279\u5148\u751F\uFF0C\u6211\u771F\u662F\u611A\u8822\u5F97\u53EF\u6015......"
  - "\u4E0D\u662F\u8FD9\u6837\u7684\uFF0C[chapterjudith.calling_her_by]\uFF0C\u4F60\u53EA\u662F\u9677\u5165\u4E86\u7EDD\u671B\uFF0C\u6240\u6709\u7684\u95EE\u9898\u805A\u96C6\u6210\u4E00\u4E2A\u5DE8\u5927\u7684\u56F0\u5883\u538B\u5728\u4F60\u8EAB\u4E0A\uFF0C\u4F60\u770B\u4E0D\u51FA\u8DEF\u662F\u5F88\u6B63\u5E38\u7684\u3002"
  - "[chapterjudith.calling_her_by]\uFF0C\u6211\u5F88\u5F00\u5FC3\u4F60\u80FD\u8FD9\u6837\u611F\u89C9\u3002"
  - ......
  - "\u6211\u8FD8\u53EF\u4EE5\u7EE7\u7EED\u505A\u4E39\u5C3C\u7684\u5988\u5988\uFF0C\u662F\u4E48\uFF1F"
  - "\u662F\u7684\uFF0C\u4E39\u5C3C\u8FD8\u9700\u8981\u4F60\uFF0C[chapterjudith.calling_her_by]\u3002"
  - "\u8FD9\u8BF4\u660E\u5979\u5927\u7EA6\u6B20\u7F34\u4E86\u534A\u5E74\u623F\u79DF\u3002"
  - "\u6211\u4ECE\u4F60\u7684\u8BDD\u91CC\u542C\u5230\u7684\u662F\u4ED6\u4EEC\u5224\u65AD\u6807\u51C6\u7684\u80A4\u6D45\uFF0C\u6211\u60F3\u4F60\u662F\u5426\u53EF\u9760\u3001\u662F\u5426\u80FD\u505A\u597D\u5DE5\u4F5C\uFF0C\u4E00\u5B9A\u548C\u4ED6\u4EEC\u7684\u8BC4\u5224\u65E0\u5173\u3002"
  - "\u8BB0\u4F4F\u8FD9\u4E00\u70B9\u3002"
  - "\u8C22\u8C22\u4F60\uFF0C\u5948\u7279\u5148\u751F\uFF0C\u548C\u4F60\u8BF4\u8BDD\u7684\u65F6\u5019\u4E0D\u77E5\u9053\u4E3A\u4EC0\u4E48\uFF0C\u6211\u80FD\u611F\u89C9\u5230\u4F60\u662F\u53EF\u4EE5\u7406\u89E3\u6211\u7684\u3002\r\n\r\n\u8FD9\u662F\u8FD9\u4E48\u957F\u65F6\u95F4\u91CC\uFF0C\u6211\u7B2C\u4E00\u6B21\u89C9\u5F97\u6211\u53EF\u4EE5\u4E0D\u8FD9\u4E48\u5B64\u7ACB\u65E0\u63F4......"
  - "\u867D\u7136\u6211\u4F9D\u7136\u770B\u4E0D\u5230\u672A\u6765\u7684\u51FA\u8DEF\uFF0C\u4F46\u662F\u548C\u4F60\u8C08\u4E86\u4E4B\u540E\uFF0C\u660E\u5929\u597D\u50CF\u4E0D\u518D\u50CF\u4E4B\u524D\u90A3\u6837\uFF0C\u65E0\u6BD4\u5730\u53EF\u6015......"
  - "\u4E0D\u7528\u60F3\u90A3\u4E9B\u592A\u9065\u8FDC\u7684\u4E8B\u60C5\uFF0C\u53EA\u8981\u4F60\u4E0D\u518D\u6050\u60E7\u660E\u5929\u7684\u5230\u6765\uFF0C\u5C31\u5DF2\u7ECF\u662F\u6700\u597D\u7684\u4E8B\u60C5\u4E86\u3002"
  - "\u90A3\u4E48\uFF0C\u4F60\u613F\u610F\u5750\u5728\u8FDC\u79BB\u7164\u6C14\u7684\u5730\u65B9\uFF0C\u628A\u95E8\u9501\u6253\u5F00\u5417\uFF1F\u7231\u4E3D\u4E1D\u5E94\u8BE5\u5C31\u5FEB\u8981\u5230\u4E86\u3002"
  - "\u5948\u7279\u5148\u751F\uFF0C\u6211\u597D\u50CF\uFF0C\u6CA1\u6709<b>\u90A3\u4E48</b>\u5BB3\u6015\u660E\u5929\u4E86......"
  - "\u867D\u7136\u4F9D\u7136\u770B\u4E0D\u5230\u672A\u6765\u7684\u51FA\u8DEF\uFF0C\u4F46\u662F\u548C\u4F60\u8C08\u4E86\u4E4B\u540E\uFF0C\u660E\u5929\u597D\u50CF\u4E0D\u518D\u50CF\u4E4B\u524D\u90A3\u6837\uFF0C\u53EF\u6015\u5230\u8BA9\u6211\u60F3\u8C61\u4E0D\u5230\u81EA\u5DF1\u53EF\u4EE5\u8DE8\u8D8A\u5B83......"
  - "\u4E0D\u7528\u60F3\u90A3\u4E9B\u592A\u9065\u8FDC\u7684\u4E8B\u60C5\uFF0C\u53EA\u8981\u4F60\u4E0D\u518D\u6050\u60E7\u660E\u5929\u7684\u5230\u6765\uFF0C\u5C31\u5DF2\u7ECF\u662F\u6700\u597D\u7684\u4E8B\u60C5\u4E86\u3002"
  - "\u90A3\u4E48\uFF0C\u4F60\u613F\u610F\u5750\u5728\u8FDC\u79BB\u7164\u6C14\u7684\u5730\u65B9\uFF0C\u628A\u95E8\u9501\u6253\u5F00\u5417\uFF1F\u7231\u4E3D\u4E1D\u5E94\u8BE5\u5C31\u5FEB\u8981\u5230\u4E86\u3002"
  - ......
  - "\u8C22\u8C22\u4F60\uFF0C\u5948\u7279\u5148\u751F\uFF0C\u80FD\u591F\u7406\u89E3\u6211\uFF0C\u8BF4\u51FA\u90A3\u4E9B\u6211\u81EA\u5DF1\u90FD\u4E0D\u6562\u8BF4\u51FA\u53E3\u7684\u8BDD\u3002"
  - "\u6211\u4F1A\u6309\u7167\u4F60\u8BF4\u7684\u53BB\u505A\u3002\r\n\r\n\u665A\u5B89\uFF0C\u5948\u7279\u5148\u751F\u3002"
  - "\u5FFD\u7136\u4E4B\u95F4\uFF0C\u4F60\u611F\u89C9\u5230\u4E00\u4E9B\u4E8B\u7269\u7684\u5B58\u5728\u2014\u2014"
  - "\u4E00\u901A\u7535\u8BDD\uFF0C\u6B63\u5728\u5411\u7740\u8FD9\u5EA7\u5DF2\u7ECF\u505C\u673A\u7684\u7535\u8BDD\u673A\u62E8\u53F7\u3002\r\n\r\n\u4E00\u901A\u6765\u81EA\u9644\u8FD1\u7535\u8BDD\u4EAD\u5185\u7684\u7535\u8BDD\uFF0C\u662F\u6731\u8FEA\u4E1D\u7684\u59D0\u59D0\u6253\u6765\u7684\u3002\r\n\r\n\u7535\u4FE1\u53F7\u50CF\u4E00\u53EA\u732B\u513F\u90A3\u6837\u5728\u5DF2\u7ECF\u6D88\u5931\u7684\u95E8\u8FB9\u5F98\u5F8A\uFF0C\u6B63\u5728\u78E8\u8E6D\u7740\u4F60\u7684\u811A\u8E1D\uFF0C\u4E00\u8FB9\u8F7B\u67D4\u5730\u6253\u7740\u547C\u565C\u3002"
  - "\u65F6\u95F4\u5230\u4E86\u3002\u4F60\u5728\u8FD9\u91CC\u6240\u9700\u8981\u505C\u7559\u7684\u65F6\u95F4\u5DF2\u7ECF\u7ED3\u675F\uFF0C\u4F60\u53EF\u4EE5\u5E2E\u6731\u8FEA\u4E1D\u63A5\u901A\u8FD9\u901A\u7535\u8BDD\uFF0C\u4F60\u77E5\u9053\u5979\u5DF2\u7ECF\u5B89\u5168\u4E86\u3002"
  - "\uFF08\u62A5\u7EB8\u4E0A\u7684\u8BA3\u544A\u5DF2\u7ECF\u5728\u6591\u9A73\u6D88\u5931......\uFF09"
  - "\u4F46\u4F60\u4E5F\u53EF\u4EE5\u9009\u62E9\u5C06\u8FD9\u901A\u7535\u8BDD\u60AC\u7F6E\u5230\u51E0\u5206\u949F\u4E4B\u540E\u63A5\u5165\uFF0C\u7EE7\u7EED\u5C06\u5BF9\u8BDD\u8FDB\u884C\u4E0B\u53BB\u3002\r\n\r\n\u4F60\u60F3\u600E\u4E48\u505A\uFF1F"
  - "\u5948\u7279\u5148\u751F\uFF1F"
  - "\u6211\u5728\u3002\r\n\r\n\u6211\u4EEC\u521A\u624D\u5728\u8BF4\uFF1F"
  - "\u6CA1\u6709\u56DE\u7B54\u3002\r\n\r\n\u7535\u8BDD\u90A3\u4E00\u7AEF\u7684\u58F0\u97F3\u6D88\u5931\u4E86\u3002\u4F60\u518D\u6B21\u5C1D\u8BD5\u547C\u5524\uFF1B\u7136\u800C\u4ECE\u6211\u7684\u6DF1\u5904\u4F60\u53EA\u611F\u53D7\u5230\u4E00\u7247\u65E0\u4EBA\u63A5\u542C\u7684\u7A7A\u832B\u3002\r\n\r\n\u8FC7\u4E86\u4E00\u4F1A\u513F\uFF0C\u4F60\u542C\u5230\u7535\u8BDD\u53E6\u4E00\u7AEF\u4F20\u6765\u5FD9\u97F3\u3002\r\n\r\n\u5979\u8FD8\u662F\u6309\u4E0B\u4E86\u6302\u65AD\u952E\u3002"
  - "\u6CA1\u6709\u65F6\u95F4\u4E3A\u4F60\u201C\u5931\u8D25\u7684\u5C1D\u8BD5\u201D\u611F\u5230\u5FC3\u75DB\u4E86\u3002\u6709\u4E9B\u4E8B\u60C5\u53EA\u4F1A\u51DD\u56FA\u6210\u65E0\u53EF\u6539\u53D8\u7684\u73B0\u5B9E\uFF0C\u54EA\u6015\u662F\u4F60\uFF0C\u4E5F\u53EA\u80FD\u5728\u7EC8\u5C40\u5230\u6765\u4E4B\u524D\uFF0C\u591A\u5F04\u51FA\u51E0\u58F0\u56DE\u54CD\u3002\r\n\r\n\u73B0\u5728\uFF0C\u5F00\u59CB\u4E0B\u4E00\u4E2A\u5C1D\u8BD5\u5427\u3002"
  - "\u4F60"
  - "\u73A9\u5BB6\u89D2\u8272"
  - "\u611F\u6027\uFF1A\u5BF9\u60C5\u7EEA\u7684\u611F\u77E5\u3001\u7AD9\u5728\u5BF9\u65B9\u7684\u89D2\u5EA6\u8003\u8651\u3001\u7406\u89E3\u91CD\u89C6\u4ED6\u4EBA\u548C\u81EA\u5DF1\u7684\u611F\u53D7\u3002\r\n\u7406\u6027\uFF1A\u5BF9\u903B\u8F91\u7684\u91CD\u89C6\u3001\u5BF9\u4E8B\u5B9E\u4F9D\u636E\u7684\u91CD\u89C6\u3001\u5BF9\u903B\u8F91\u6F0F\u6D1E\u7684\u654F\u611F\u3002\r\n\r\n\u7406\u60F3\uFF1A\u5BF9\u62BD\u8C61\u7406\u5FF5\u7684\u91CD\u89C6\u3001\u5BF9\u4E8B\u7269\u4E0E\u5185\u5FC3\u610F\u4E49\u7684\u91CD\u89C6\u3002\r\n\u52A1\u5B9E\uFF1A\u5BF9\u7269\u8D28\u73B0\u5B9E\u7684\u5173\u6CE8\u3001\u5BF9\u611F\u5B98\u611F\u53D7\u7684\u5173\u6CE8\u3002"
  - "1967\u5E74\u4F4D\u4E8E\u7EBD\u7EA6\u57CE\u5E02\u4E00\u5904\u516C\u5BD3\u4E2D\u7684\u90FD\u5E02\u4F20\u8BF4\u3002\u80FD\u591F\u5C06\u4E00\u90E8\u5206\u7684\u81EA\u6211\u5316\u4F5C\u7535\u4FE1\u53F7\uFF0C\u6295\u5165\u5DE8\u5927\u57CE\u5E02\u7684\u94DC\u7EDE\u7EBF\u7F51\u7EDC\uFF0C\u7A7F\u8FC7\u4EA4\u6362\u673A\uFF0C\u65E7\u516C\u5BD3\u5899\u5185\u8001\u5316\u7684\u7EBF\u8DEF\uFF0C\u65E0\u4EBA\u503C\u5B88\u7684\u603B\u673A\u548C\u672A\u63A5\u6765\u7535\u7684\u94C3\u97F3\uFF0C\u5230\u8FBE\u5373\u5C06\u65E0\u4EBA\u63A5\u542C\u7684\u7EC8\u70B9\u3002\u542C\u5230\u7535\u8BDD\u94C3\u58F0\u7684\u4EBA\uFF0C\u5373\u4FBF\u5DF2\u7ECF\u9057\u5F03\u4E86\u81EA\u6211\u3001\u5931\u53BB\u4E86\u63A5\u542C\u7535\u8BDD\u4E0E\u5916\u754C\u8054\u7CFB\u7684\u610F\u5FD7\uFF0C\u4E5F\u4F1A\u65E0\u610F\u8BC6\u5730\u6CE8\u610F\u5230\u8FD9\u56DE\u8361\u5728\u591C\u665A\u623F\u5C4B\u4E2D\u7684\u5947\u5F02\u94C3\u58F0\uFF0C\u62FF\u8D77\u542C\u7B52\u653E\u5728\u8033\u8FB9\u3002\u80FD\u529B\u5177\u6709\u526F\u4F5C\u7528\uFF0C\u5F53\u81EA\u6211\u7F6E\u8EAB\u4E8E\u6D69\u701A\u5FAE\u6F20\u7684\u7535\u566A\u4E4B\u6D77\u6DF1\u5904\uFF0C\u6781\u6613\u56E0\u4E3A\u7F3A\u5C11\u951A\u70B9\u800C\u8FF7\u5931\u2014\u2014\u56E0\u6B64\u5982\u679C\u4E3A\u4E86\u7167\u987E\u4ED6\u4EBA\u7684\u5FC3\u60C5\u800C\u8FC7\u5EA6\u5730\u9690\u85CF\u5728\u4EBA\u683C\u9762\u5177\u4E4B\u4E0B\uFF0C\u5BF9\u5176\u800C\u8A00\u662F\u4E00\u4EF6\u5371\u9669\u7684\u4E8B\u60C5\u3002\u4EE5\u771F\u6211\u7684\u9762\u8C8C\u548C\u4ED6\u4EBA\u6C9F\u901A\uFF0C\u624D\u80FD\u907F\u514D\u8FF7\u5931\u81EA\u6211\u3002\u800C\u70DF\u8349\u610F\u5916\u5730\u53EF\u4EE5\u5E2E\u52A9ta\u7A0D\u5FAE\u5730\u9547\u5B9A\u4E0B\u6765\u3002"
  - "\u6731\u8FEA\u4E1D\xB7\u7FF0\u83B1"
  - "\u7406\u6027/\u7406\u60F3"
  - "\u611F\u6027\uFF1A\u5BF9\u60C5\u7EEA\u7684\u611F\u77E5\u3001\u7AD9\u5728\u5BF9\u65B9\u7684\u89D2\u5EA6\u8003\u8651\u3001\u7406\u89E3\u91CD\u89C6\u4ED6\u4EBA\u548C\u81EA\u5DF1\u7684\u611F\u53D7\u3002\r\n\u7406\u6027\uFF1A\u5BF9\u903B\u8F91\u7684\u91CD\u89C6\u3001\u5BF9\u4E8B\u5B9E\u4F9D\u636E\u7684\u91CD\u89C6\u3001\u5BF9\u903B\u8F91\u6F0F\u6D1E\u7684\u654F\u611F\u3002\r\n\r\n\u7406\u60F3\uFF1A\u5BF9\u62BD\u8C61\u7406\u5FF5\u7684\u91CD\u89C6\u3001\u5BF9\u4E8B\u7269\u4E0E\u5185\u5FC3\u610F\u4E49\u7684\u91CD\u89C6\u3002\r\n\u52A1\u5B9E\uFF1A\u5BF9\u7269\u8D28\u73B0\u5B9E\u7684\u5173\u6CE8\u3001\u5BF9\u611F\u5B98\u611F\u53D7\u7684\u5173\u6CE8\u3002"
  - "\u4E3A\u517B\u80B2\u513F\u5B50\u5728\u8D85\u5E02\u517C\u804C\uFF0C\u88C1\u5458\u540E\u5F7B\u5E95\u5931\u53BB\u6536\u5165\u6765\u6E90\r\n\u5973\u6027\u5728\u5DE5\u4F5C\u4E2D\u5F85\u9047\u4F4E\uFF0C\u6CA1\u6709\u5B58\u6B3E\r\n\u79DF\u4F4F\u7684\u516C\u5BD3\u56E0\u4E3A\u6B20\u7F34\u534A\u5E74\u800C\u88AB\u623F\u4E1C\u50AC\u4FC3\u642C\u79BB\uFF0C\u8FDE\u7EED\u6536\u5230\u9650\u671F\u642C\u8FC1\u901A\u77E5\r\n\u5411\u4EB2\u621A\u6C42\u52A9\u501F\u94B1\u65E0\u679C\uFF0C\u7F3A\u5C11\u5BF9\u5E94\u7684\u793E\u4F1A\u6551\u6D4E\r\n\u611F\u89C9\u5230\u65E0\u529B\u517B\u80B2\u513F\u5B50\uFF0C\u8BD5\u56FE\u5E26\u7740\u513F\u5B50\u4E00\u8D77\u81EA\u6740"
  - "\u7535\u566A\u4E4B\u6D77"
  - "\u65C1\u767D"
