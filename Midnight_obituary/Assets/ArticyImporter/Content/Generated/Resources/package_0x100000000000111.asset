        mText:
          value:
            mValue: "\u83B7\u5F97\u4E86\u5F55\u53D6\u3001\u5373\u5C06\u53EF\u4EE5\u8BFB\u5927\u5B66\uFF0C\u4F46\u7A81\u7136\u88AB\u8FEB\u4E2D\u6B62\u4E86\u6B63\u5E38\u751F\u6D3B\u8F68\u8FF9\r\n\r\n\u627F\u8BFA\u548C\u5979\u7ED3\u5A5A\u7684\u7537\u53CB\u79BB\u5F00\u5979\u53BB\u8BFB\u5927\u5B66\r\n\r\n\u4F20\u7EDF\u5929\u4E3B\u6559\u5BB6\u5EAD\u5E26\u6765\u7684\u538B\u529B\uFF0C\u5355\u4EB2\u7236\u4EB2\u5BF9\u5979\u7BA1\u675F\u6781\u4E25\uFF0C\u542C\u5230\u7236\u4EB2\u548C\u62A4\u58EB\u7684\u804A\u5929\u89C9\u5F97\u5373\u5C06\u88AB\u53D1\u73B0\r\n\r\n\u5973\u6027\u5DE5\u8D44\u5FAE\u8584\uFF0C\u5355\u8EAB\u6BCD\u4EB2\u65E0\u6CD5\u5728\u65E0\u4E08\u592B\u62C5\u4FDD\u4E0B\u7533\u8BF7\u623F\u8865\uFF0C\u7533\u8BF7\u4E13\u4E3A\u672A\u5A5A\u6000\u5B55\u5973\u6027\u7684ADC\u798F\u5229\u4F1A\u9762\u4E34\u6781\u5927\u7684\u793E\u4F1A\u6C61\u540D\u7684\u538B\u529B\uFF0C\u56E0\u6B64\u65E0\u529B\u627F\u62C5\u623F\u79DF\r\n\r\n\u89C9\u5F97\u81EA\u5DF1\u4F1A\u88AB\u5F3A\u5236\u9001\u5230\u6BCD\u6027\u6536\u5BB9\u6240\u6216\u8005\u5B69\u5B50\u5F3A\u884C\u88AB\u9001\u8D70"
