        mText:
          value:
            mValue: "\u6536\u5BB9\u540E\u88AB\u533B\u7597\u7CFB\u7EDF\u91CC\u7684\u4EBA\u8BA8\u538C\u3001\u88AB\u89C6\u4F5C\u9EBB\u70E6\u3001\u9AD8\u9700\u6C42\u3001\u4E0D\u597D\u76F8\u5904\r\n\r\n\u62A5\u7EB8\u5BF9\u62BD\u70DF\u7684\u8D1F\u9762\u6050\u614C\u6027\u62A5\u9053\u4F7F\u5F97\u60A3\u8005\u8BA4\u4E3A\u5F97\u4E86\u80BA\u764C\u662F\u81EA\u5DF1\u81EA\u627E\u7684\u65E0\u6CD5\u83B7\u5F97\u793E\u4F1A\u540C\u60C5\r\n\r\n\u5BF9\u51FA\u9662\u7684\u6050\u60E7\uFF0C\u60F3\u8C61\u662F\u88AB\u653E\u5F03\u7684\u8C61\u5F81\uFF0C\u81EA\u5DF1\u6C38\u8FDC\u4E5F\u597D\u4E0D\u4E86\r\n\r\n\u60F3\u8C61\u81EA\u5DF1\u662F\u5BB6\u5EAD\u7684\u62D6\u7D2F"
