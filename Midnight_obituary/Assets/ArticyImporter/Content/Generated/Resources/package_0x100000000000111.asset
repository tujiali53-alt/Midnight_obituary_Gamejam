        mText:
          value:
            mValue: "\u5A92\u4F53\u4E0A\u5B58\u5728\u8FC7\u5EA6\u6218\u4E89\u66B4\u529B\u7684\u5F71\u50CF/\u56FE\u50CF\uFF0C\u5A92\u4F53\u5316\u6218\u4E89\u5BF9\u57CE\u5E02\u65E5\u5E38\u7684\u5165\u4FB5\r\n\r\n\u5373\u5C06\u9762\u4E34\u5175\u5F79\r\n\r\n\u5728\u6821\u56ED\u73AF\u5883\u4E2D\u53D7\u5230\u6392\u65A5\u4EE5\u53CA\u9752\u5C11\u5E74\u7684\u60C5\u7EEA\u8106\u5F31\r\n\r\n\u53CD\u6218\u6D6A\u6F6E\u7684\u793E\u4F1A\u5F71\u54CD\uFF0Cmorrison\u5728\u4E94\u89D2\u5927\u697C\u524D\u81EA\u711A\u7684\u4E8B\u4EF6\u521A\u521A\u53D1\u751F\u4E0D\u4E45\r\n\r\n\u7267\u5E08\u5173\u4E8E\u53CD\u6218\u7684\u8BB2\u9053\u4E0E\u5BF9\u5B97\u6559\u793E\u7FA4\u7684\u5F52\u5C5E\u611F"
