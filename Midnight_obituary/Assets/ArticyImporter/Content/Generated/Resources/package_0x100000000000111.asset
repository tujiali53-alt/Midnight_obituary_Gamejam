        mText:
          value:
            mValue: "\uFF08\u53EF\u80FD\u662F\u4E3B\u52A8\u6253\u7535\u8BDD\u8FC7\u6765\u7684\uFF0C\u56E0\u4E3A\u66FE\u7ECF\u63A5\u5230\u8FC7\u5348\u591C\u6765\u7535\uFF09\r\n\r\n\u4E24\u6B21\u81EA\u6740\u672A\u9042\u4F7F\u5176\u88AB\u8F6C\u5165\u66F4\u52A0\u4E13\u4E1A\u5B89\u5168\u7684\u7CBE\u795E\u6536\u5BB9\u673A\u6784\uFF0C\u7136\u800C\u7CBE\u795E\u536B\u751F\u7CFB\u7EDF\u53BB\u4EBA\u683C\u5316\u7684\u4E13\u4E1A\u7BA1\u7406\u5BF9\u75C5\u4EBA\u9020\u6210\u66F4\u5927\u7684\u538B\u8FEB+\u75C5\u623F\u89C4\u5219\u5C06\u75C5\u4EBA\u5B9A\u4E49\u4E3A\u65E0\u80FD\u7684\u4EBA\r\n\r\n\u673A\u6784\u4E2D\u4E00\u4E9B\u9632\u81EA\u6740\u7684\u624B\u6BB5\u4F7F\u4EBA\u60F3\u5230\u65B0\u7684\u81F4\u6B7B\u65B9\u6CD5\r\n\r\n\u62A4\u58EB\u548C\u52A9\u7406\u9762\u5BF9\u5979\u6FC0\u70C8\u8C08\u8BBA\u81EA\u5DF1\u65F6\u5F80\u5F80\u4E0D\u77E5\u9053\u600E\u4E48\u56DE\u5E94\uFF0C\u5C06\u5979\u201C\u8F6C\u7ED9\u533B\u751F\u201D\r\n\r\n\u5DE5\u4F5C\u4EBA\u5458\u5F62\u6210\u201C\u5979\u4E00\u5B9A\u4F1A\u81EA\u6740\u201D\u7684\u5171\u8BC6\uFF0C\u75C5\u623F\u4E2D\u5176\u4ED6\u81EA\u6740\u4E8B\u4EF6\u4E5F\u8BA9\u5DE5\u4F5C\u4EBA\u5458\u666E\u904D\u8BA4\u4E3A\u81EA\u5DF1\u65E0\u80FD\u4E3A\u529B\r\n\r\n\u4ECE\u7CBE\u795E\u673A\u6784\u9003\u79BB\u6253\u7B97\u5728\u9547\u65C5\u9986\u670D\u836F\u81EA\u6740"
